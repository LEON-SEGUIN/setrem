---
import '../styles/global.css';
// Le LCP est du texte sur toutes les pages : précharger les deux sous-
// ensembles latins évite que le navigateur ne découvre les polices au
// bout de la chaîne HTML → CSS → @font-face.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import {
  ui,
  toLocale,
  localeAlternates,
  getAlternatePath,
} from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Chemin canonique de la page, ex. "/" ou "/nos-solutions" */
  path?: string;
  /** Pages à exclure de l'index (ex. /contact/merci) */
  noindex?: boolean;
  /** Données structurées supplémentaires (ex. Article), en plus du LocalBusiness */
  jsonLdExtra?: Record<string, unknown>;
}

const { title, description, path = '/', noindex = false, jsonLdExtra } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = ui[locale];

const site = Astro.site ?? new URL('https://www.setrem.com');
const canonical = new URL(path, site);
const ogImage = new URL('/og.png', site);

// hreflang : les deux membres de la paire, plus x-default sur le français
// (la langue d'origine du contenu).
const pathFr = locale === 'fr' ? path : getAlternatePath(path, 'fr');
const pathEn = locale === 'en' ? path : getAlternatePath(path, 'en');
const alternates =
  pathFr && pathEn
    ? [
        { hreflang: 'fr', href: new URL(pathFr, site).toString() },
        { hreflang: 'en', href: new URL(pathEn, site).toString() },
        { hreflang: 'x-default', href: new URL(pathFr, site).toString() },
      ]
    : [];

// Données réelles - voir scrape/SYNTHESE.md. Ne rien inventer ici.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'SETREM',
  description: t.jsonLd.description,
  url: site.toString(),
  telephone: '+33232250847',
  foundingDate: '1986',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ZI Les Pâtis, 7 rue Robert Dumont',
    postalCode: '27400',
    addressLocality: 'Acquigny',
    addressCountry: 'FR',
  },
  sameAs: ['https://www.linkedin.com/company/setremextrusion'],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#004C91" />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatin} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SETREM" />
    <meta property="og:locale" content={localeAlternates[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      jsonLdExtra && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtra)} />
      )
    }

    <script is:inline>
      // Marqueur JS : les états initiaux d'animation (contenu masqué,
      // sections épinglées) ne s'appliquent que si cette classe est là.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
