        </tr>
      </thead>
      <tbody>
        <tr><th scope="row">Huile (ajustée)</th><td>63,0</td><td>63,9</td><td>85,7</td></tr>
        <tr><th scope="row">Azote</th><td>80,1</td><td>78,9</td><td>86,8</td></tr>
