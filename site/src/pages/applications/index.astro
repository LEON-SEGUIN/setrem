---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LinkCards from '../../components/LinkCards.astro';
import ShowcaseBand from '../../components/ShowcaseBand.astro';
import CTABand from '../../components/CTABand.astro';
import { marches } from '../../data/marches';
import sojaImg from '../../assets/img/article-graine-soja.webp';

const items = marches.fr.map((m) => ({
  href: `/applications/${m.slug}`,
  titre: m.titre,
  texte: m.texte,
  image: m.image,
  alt: m.alt,
}));
---

<PageLayout
  title="Applications - petfood, aquaculture, alimentation humaine, bétail | SETREM"
  description="Quatre marchés, une même vis : animaux domestiques, aquaculture, alimentation humaine, bétail. Lignes complètes, sécheur compris, de 40 kg/h à 9 t/h."
  path="/applications"
>
  <PageHero
    kicker="Applications"
    titre="Quatre marchés, une même vis."
    lede="Des machines sur mesure pour vos produits, avec des solutions d'extrusion complètes incluant le sécheur. Des capacités allant de 40 kg/h à 9 t/h."
  />

  <section class="band sheet" aria-labelledby="marches-titre">
    <h2 class="visually-hidden" id="marches-titre">Les quatre marchés servis</h2>
    <div class="container">
      <LinkCards items={items} cols={4} cta="Voir le marché" />
    </div>
  </section>

  <ShowcaseBand
    id="mp-titre"
    eyebrow="Et aussi"
    titre="Le traitement des matières premières."
    accent="matières premières."
    texte="Les extrudeurs SETREM sont aussi utilisés pour le traitement des matières premières - soja, colza, blé et autres céréales - et en préparation à l'extraction mécanique d'huile sur oléagineux."
    image={sojaImg}
    alt="Graines de soja, matière première du traitement par extrusion"
    compact
  >
    <p class="mp-liens reveal" style="--ri: 2">
      <a href="/loil-de-lexpert/traitement-des-matieres-premieres-soja">
        Traitement du soja →
      </a>
      <a href="/loil-de-lexpert/traitement-des-matieres-premieres-cereales">
        Traitement des céréales →
      </a>
      <a href="/loil-de-lexpert/procede-de-traitement-de-la-graine-de-soja">
        Préparation à l'extraction d'huile →
      </a>
    </p>
  </ShowcaseBand>

  <CTABand />
</PageLayout>

<style>
  .mp-liens {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .mp-liens a:hover {
    color: var(--highlight);
  }
</style>
