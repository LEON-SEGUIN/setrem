---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { modeles, applications, fmt, disclaimer } from '../../data/capacites';

// ⚠️ Y160 / Y200 : la plaquette PDF donne d'autres puissances (110–132 et
// 160–200 kW) — arbitrage client en attente, ne pas trancher ici.

// ⚠️ Le chiffre de tête est lu dans le tableau affiché juste en dessous
// (minimum : S50 en soja à sec, 100 kg/h — maximum : Z300 en extrusion
// humide, 9 000 kg/h). L'ancien site annonce « 40 kg/h » d'amplitude
// basse, valeur qui n'apparaît nulle part dans le tableau : l'afficher
// ici contredisait la donnée à l'écran. Repris ailleurs sur le site tel
// que le client l'écrit — arbitrage client en attente (ligne pilote ?
// autre application ?).
const stats = [
  { valeur: '100 kg/h – 9 t/h', label: 'de production, du S50 au Z300' },
  { valeur: '22 – 250', label: 'kW de puissance installée' },
  { valeur: '3 – 9', label: 'chambres par fourreau' },
];
---

<PageLayout
  title="Tableau des capacités des équipements — S50 à Z300 | SETREM"
  description="Les capacités des six extrudeurs monovis SETREM en kg/h : soja à sec, extrusion humide, mélange céréales, petfood et poisson, du S50 au Z300."
  path="/nos-solutions/tableau-des-capacites-des-equipements"
>
  <PageHero
    kicker="Nos solutions"
    titre="Le tableau des capacités."
    lede="Six extrudeurs monovis couvrent l'ensemble des débits, de la ligne pilote à la production industrielle. Toutes les valeurs sont exprimées en kilogrammes par heure."
  >
    <ul class="phero-stats">
      {
        stats.map(({ valeur, label }) => (
          <li>
            <span class="phero-stats__valeur">{valeur}</span>
            <span class="phero-stats__label">{label}</span>
          </li>
        ))
      }
    </ul>
  </PageHero>

  <section class="band sheet" aria-labelledby="tableau-titre">
    <div class="container">
      <div class="band__head">
        <h2 class="band__title reveal" id="tableau-titre">
          Capacités par modèle et par application.
        </h2>
        <p class="band__sub reveal">{disclaimer}</p>
      </div>

      <div class="table-scroll reveal">
        <table class="table-data table-data--flow">
          <caption class="visually-hidden">
            Capacités des extrudeurs SETREM en kilogrammes par heure, par
            modèle et par application
          </caption>
          <thead>
            <tr>
              <th scope="col">Modèle</th>
              <th scope="col">Chambres</th>
              <th scope="col">Puissance (kW)</th>
              {applications.map((app) => <th scope="col">{app.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              modeles.map((m, j) => (
                <tr>
                  <th scope="row" class="model-ref">{m.ref}</th>
                  <td>{m.chambres}</td>
                  <td>{m.kw}</td>
                  {applications.map((app) => (
                    <td>
                      {fmt(app.valeurs[j][0])} – {fmt(app.valeurs[j][1])}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="suite reveal">
        <a class="btn btn--dark" href="/contact">Discuter de votre débit</a>
        <a class="suite__lien" href="/nos-solutions/extrudeurs">
          Découvrir les extrudeurs →
        </a>
        <a class="suite__lien" href="/la-ligne-pilote">
          Tester votre formule sur la ligne pilote →
        </a>
        <a
          class="suite__lien"
          href="/docs/plaquette-solutions-extrusion.pdf"
          type="application/pdf"
        >
          Télécharger la plaquette (PDF, 3,4 Mo) →
        </a>
      </div>
    </div>
  </section>

  <CTABand />
</PageLayout>

<style>
  .phero-stats {
    margin-top: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  html.js .phero-stats {
    animation: stats-in 0.9s var(--ease-out) 0.6s both;
  }

  @keyframes stats-in {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }

  .phero-stats li {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid var(--blue-300);
  }

  .phero-stats__valeur {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h3);
    color: var(--blue-800);
    font-variant-numeric: tabular-nums;
  }

  .phero-stats__label {
    font-size: var(--text-small);
    color: var(--steel-700);
  }

  .suite {
    margin-top: var(--space-8);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .suite__lien {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .suite__lien:hover {
    color: var(--highlight);
  }

  @media (prefers-reduced-motion: reduce) {
    html.js .phero-stats {
      animation: none;
    }
  }
</style>
