---
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import ShowcaseBand from '../components/ShowcaseBand.astro';
import CTABand from '../components/CTABand.astro';
import piloteImg from '../assets/img/ligne-pilote.webp';
import pilote3dImg from '../assets/img/3d-ligne-pilote-large.webp';
import precoImg from '../assets/img/3d-carte-preconditionneur.webp';
import visImg from '../assets/img/3d-carte-vis.webp';
import cutterImg from '../assets/img/3d-carte-cutter.webp';

// La ligne, dans l'ordre où la matière la traverse. Images : le modèle 3D
// de la ligne pilote, construit d'après les plans SETREM (dossier
// video/extrudeur-3d/). Textes : ceux du client, repris de l'article PBR
// et de l'anatomie de la page extrudeurs - rien d'ajouté.
const organes = [
  {
    titre: 'Préconditionnement',
    texte:
      "Un préconditionneur birotor PBR160 hydrate et mélange la formule avant l'extrusion : eau, vapeur, et au besoin slurrys ou huile.",
    image: precoImg,
    alt: 'Le préconditionneur PBR160 de la ligne pilote, capot levé et rotors sortis',
    href: '/nos-solutions/preconditionneurs',
    lien: 'Les préconditionneurs',
  },
  {
    titre: 'Extrusion',
    texte:
      "Le fourreau se compose de différents modèles de vis, d'écluses et de chambres en acier à haute résistance, à double enveloppe pour être réchauffées ou refroidies.",
    image: visImg,
    alt: "L'extrudeur de la ligne pilote, colliers ouverts : la vis sort du fourreau",
    href: '/nos-solutions/extrudeurs',
    lien: 'Les extrudeurs',
  },
  {
    titre: 'Coupe',
    texte:
      'Le cutter, articulé et solidaire de la machine, porte des couteaux interchangeables. Son ouverture facile rend la filière très accessible.',
    image: cutterImg,
    alt: 'Le cutter de la ligne pilote ouvert sur son couteau, la filière tournée vers nous',
    href: '/nos-solutions/extrudeurs#anatomie',
    lien: "L'anatomie d'un extrudeur",
  },
];
---

<PageLayout
  title="La ligne pilote - testez votre produit avant d'investir | SETREM"
  description="La ligne d'essai SETREM est à la disposition des industriels de l'agro-alimentaire : essais de R&D et validation d'un process d'extrusion avant d'investir."
  path="/la-ligne-pilote"
>
  <PageHero
    kicker="Recherche & développement"
    titre="Testez votre produit avant d'investir."
    lede="La ligne pilote est notre outil de recherche et de développement. Cette unité est à la disposition des industriels de l'agro-alimentaire afin de valider la faisabilité de nouveaux produits."
  />

  <!-- Refonte du 4 octobre 2026 (demande d'Arnaud Delique : « revoir la
       ligne pilote ») : la machine ouvre la page, en 3D, puis se lit
       organe par organe. La photo d'atelier reste plus bas : c'est la
       preuve que la ligne existe, le rendu ne la remplace pas. -->
  <ShowcaseBand
    id="machine-titre"
    eyebrow="La ligne pilote SETREM"
    titre="Une vraie machine SETREM, à l'échelle de l'essai."
    accent="à l'échelle de l'essai."
    texte="Trémie, doseur, préconditionneur, extrudeur et cutter : la même anatomie que les extrudeurs de la gamme."
    image={pilote3dImg}
    alt="La ligne pilote SETREM montée : trémie, doseur, préconditionneur, extrudeur et cutter - modélisation 3D d'après les plans"
    vitesse={0.06}
    position="68% 50%"
    positionMobile="76% 50%"
  />

  <section class="band sheet" aria-labelledby="usages-titre">
    <div class="container">
      <div class="band__head">
        <p class="eyebrow">La ligne d'essai intégrée à SETREM</p>
        <h2 class="band__title reveal" id="usages-titre">
          Deux façons de s'en servir.
        </h2>
      </div>

      <div class="usages">
        <article class="usages__card reveal" style="--ri: 0">
          <p class="usages__num" aria-hidden="true">01</p>
          <h3>Essais de recherche & développement</h3>
          <p>
            Réaliser des essais dans le cadre d'un projet de recherche et
            développement spécifique - explorer une matière première, une
            texture, un produit nouveau.
          </p>
        </article>
        <article class="usages__card reveal" style="--ri: 1">
          <p class="usages__num" aria-hidden="true">02</p>
          <h3>Validation d'un process</h3>
          <p>
            Procéder à des tests pour valider un nouveau process ou un
            projet d'extrusion avec une formule donnée précise - avant
            d'engager l'investissement industriel.
          </p>
        </article>
      </div>
      <!-- Phrase du client, présente sur l'accueil de l'ancien site mais
           nulle part sur sa page ligne pilote : elle a sa place ici. -->
      <p class="usages__note reveal" style="--ri: 2">
        Nous définissons ensemble les modalités d'utilisation
        personnalisées.
      </p>
      <!-- TODO: contenu client - préciser ces modalités (durée d'un essai,
           quantités de matière à fournir, accompagnement technique,
           confidentialité des formules) pour étoffer la page. -->
    </div>
  </section>

  <section class="band band--raised" aria-labelledby="organes-titre">
    <div class="container">
      <div class="band__head">
        <p class="eyebrow">Organe par organe</p>
        <h2 class="band__title reveal" id="organes-titre">
          Ce que la matière traverse.
        </h2>
      </div>
      <ol class="organes">
        {
          organes.map((o, i) => (
            <li class="organes__card reveal" style={`--ri: ${i}`}>
              <div class="organes__media">
                <Image
                  src={o.image}
                  alt={o.alt}
                  widths={[500, 800, 1100]}
                  width={1100}
                  quality={72}
                  sizes="(max-width: 900px) 100vw, 33vw"
                  loading="lazy"
                />
              </div>
              <div class="organes__body">
                <p class="organes__num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </p>
                <h3>{o.titre}</h3>
                <p>{o.texte}</p>
                <a class="organes__lien" href={o.href}>
                  {o.lien} <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="organes__note">
        Visuels : modélisation 3D de la ligne pilote, d'après les plans
        SETREM.
      </p>
    </div>
  </section>

  <!-- La vraie machine, en atelier : la preuve après le rendu. -->
  <ShowcaseBand
    id="atelier-essais"
    eyebrow="L'atelier d'essais"
    titre="La ligne pilote, dans l'atelier SETREM à Acquigny."
    accent="à Acquigny."
    image={piloteImg}
    alt="La ligne pilote SETREM en atelier d'essais"
  />
  <!-- TODO: contenu client - modèle et puissance de l'extrudeur pilote,
       débits d'essai, séchage disponible. La composition (PBR160,
       extrudeur, cutter) vient des plans de la ligne ; le reste n'est
       documenté nulle part : ne pas le déduire des images. -->

  <section class="band band--raised" aria-label="Du pilote à la production">
    <div class="container">
      <div class="suite">
        <div class="suite__col reveal">
          <h2 class="suite__titre">Du pilote à la production.</h2>
          <p class="suite__texte">
            Une fois la faisabilité validée, la même vis change simplement
            d'échelle : six extrudeurs monovis couvrent les débits de
            40&nbsp;kg/h à 9&nbsp;t/h.
          </p>
        </div>
        <div class="suite__liens reveal" style="--ri: 1">
          <a class="btn btn--dark" href="/contact">Demander un essai</a>
          <a class="suite__lien" href="/nos-solutions/extrudeurs">
            Découvrir la gamme →
          </a>
          <a class="suite__lien" href="/nos-solutions/tableau-des-capacites-des-equipements">
            Voir le tableau des capacités →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Le chapô de la page dit déjà « à la disposition des industriels de
       l'agro-alimentaire » : le bandeau final passe à l'action. -->
  <CTABand
    titre="Un produit à valider ? Parlons d'un essai."
    texte="Dites-nous ce que vous cherchez à fabriquer et avec quelles matières premières : nous partons de là."
  />
</PageLayout>

<style>
  .usages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .usages__card {
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  .usages__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-h2);
    color: var(--blue-300);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-4);
  }

  .usages__card h3 {
    font-size: var(--text-h3);
    font-weight: 650;
    margin-bottom: var(--space-3);
  }

  .usages__card p:last-child {
    color: var(--text-body);
    font-size: var(--text-small);
  }

  /* La phrase qui referme les deux cartes : elle porte l'engagement,
     donc elle est centrée sous la paire plutôt que rangée dans l'une
     des deux colonnes. */
  .usages__note {
    margin: var(--space-8) auto 0;
    max-width: 46ch;
    text-align: center;
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .organes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .organes__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-raised);
    box-shadow: var(--shadow-sm);
  }

  /* Le studio noir du rendu 3D : le cadre prend la couleur du fond de
     l'image, pour que le recadrage ne laisse jamais de bord clair. */
  .organes__media {
    aspect-ratio: 4 / 3;
    background: #000;
  }

  .organes__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .organes__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-6);
  }

  .organes__num {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--blue-300);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-2);
  }

  .organes__body h3 {
    font-size: var(--text-h3);
    font-weight: 650;
    margin-bottom: var(--space-3);
  }

  .organes__body p:not(.organes__num) {
    color: var(--text-body);
    font-size: var(--text-small);
  }

  .organes__lien {
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .organes__lien:hover {
    color: var(--highlight);
  }

  .organes__note {
    margin-top: var(--space-6);
    font-size: var(--text-small);
    color: var(--text-muted);
  }

  .suite {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: center;
  }

  .suite__titre {
    font-size: var(--text-h2);
    font-weight: 650;
  }

  .suite__texte {
    margin-top: var(--space-3);
    color: var(--text-muted);
    max-width: 44ch;
  }

  .suite__liens {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
    justify-content: flex-end;
  }

  .suite__lien {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .suite__lien:hover {
    color: var(--highlight);
  }

  @media (max-width: 900px) {
    .usages,
    .organes,
    .suite {
      grid-template-columns: 1fr;
    }

    .suite__liens {
      justify-content: flex-start;
    }
  }
</style>
