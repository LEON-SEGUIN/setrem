---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import Process from '../components/Process.astro';
import Bento from '../components/Bento.astro';
import Capacites from '../components/Capacites.astro';
import Expert from '../components/Expert.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="SETREM - Lignes complètes d'extrusion pour l'alimentation humaine et animale"
  description="Depuis 1986, SETREM construit des lignes complètes d'extrusion : six extrudeurs monovis de 22 à 250 kW et une ligne pilote pour valider vos produits."
  path="/"
>
  <SiteNav />
  <main>
    <Hero />
    <Mission />
    <Process />
    <Bento />
    <Capacites />
    <Expert />
  </main>
  <SiteFooter />

  <script src="../scripts/scroll.js"></script>
</Layout>
