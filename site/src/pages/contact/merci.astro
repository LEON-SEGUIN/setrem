---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<PageLayout
  title="Merci - votre demande a bien été reçue | SETREM"
  description="Nous vous remercions d'avoir pris le temps de remplir notre formulaire de demande. Votre requête est en cours de traitement."
  path="/contact/merci"
  noindex
>
  <PageHero
    kicker="Contact"
    titre="Merci, c'est bien reçu."
    lede="Nous vous remercions d'avoir pris le temps de remplir notre formulaire de demande. Votre requête a bien été reçue et est en cours de traitement. Nous vous contacterons sous peu pour la suite des démarches."
    compact
  />

  <section class="band sheet band--tight" aria-label="Continuer la visite">
    <div class="container">
      <p class="retours reveal">
        <a class="btn btn--dark" href="/">Retour à l'accueil</a>
        <a class="retours__lien" href="/loil-de-lexpert">
          En attendant, l'œil de l'expert →
        </a>
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .retours {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .retours__lien {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .retours__lien:hover {
    color: var(--highlight);
  }
</style>
