---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';

const adresseQuery = encodeURIComponent(
  'SETREM, 7 rue Robert Dumont, 27400 Acquigny, France'
);
---

<PageLayout
  title="Contact — SETREM, Acquigny, Normandy"
  description="Contact SETREM: ZI Les Pâtis, 7 rue Robert Dumont, 27400 Acquigny, France. Phone +33 2 32 25 08 47. Manufacturer of complete extrusion lines since 1986."
  path="/en/contact"
>
  <PageHero
    kicker="Contact"
    titre="Let's talk about your project."
    lede="A throughput to reach, a formula to validate, a line to modernise: the SETREM team will get back to you."
  />

  <section class="band sheet" aria-label="Contact details and form">
    <div class="container contact">
      <div class="contact__infos">
        <div class="reveal">
          <h2 class="contact__titre">SETREM</h2>
          <address class="contact__adresse">
            ZI Les Pâtis<br />
            7 rue Robert Dumont<br />
            27400 Acquigny, France
          </address>
          <dl class="contact__lignes">
            <div>
              <dt>Phone</dt>
              <dd><a href="tel:+33232250847">+33 2 32 25 08 47</a></dd>
            </div>
            <div>
              <dt>Fax</dt>
              <dd>+33 2 32 40 67 88</dd>
            </div>
            <div>
              <dt>LinkedIn</dt>
              <dd>
                <a href="https://www.linkedin.com/company/setremextrusion" rel="noopener">
                  setremextrusion
                </a>
              </dd>
            </div>
            <!-- TODO: contenu client — e-mail public à confirmer (aucun sur
                 le site actuel, qui n'expose qu'un formulaire). -->
          </dl>
        </div>

        <!-- TODO: RGPD — l'iframe Google Maps dépose des cookies tiers :
             à conditionner au consentement lors de l'arbitrage cookies. -->
        <figure class="contact__map reveal" style="--ri: 1">
          <iframe
            src={`https://maps.google.com/maps?q=${adresseQuery}&z=14&hl=en&output=embed`}
            title="Location map — SETREM, ZI Les Pâtis, 7 rue Robert Dumont, 27400 Acquigny"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
          <figcaption>
            <a
              href={`https://www.google.com/maps/search/?api=1&query=${adresseQuery}`}
              rel="noopener"
            >
              Open in Google Maps →
            </a>
          </figcaption>
        </figure>
      </div>

      <!-- TODO: brancher le formulaire sur un backend (service de
           formulaires ou endpoint de l'hébergeur) avant mise en ligne,
           avec redirection vers /en/contact/thank-you. -->
      <form
        class="formulaire reveal"
        style="--ri: 2"
        method="post"
        action="/en/contact/thank-you"
      >
        <p class="formulaire__intro">
          Describe your project and we will call you back.
        </p>

        <div class="formulaire__grille">
          <div class="champ">
            <label for="nom">Name <span class="champ__req" aria-hidden="true">*</span></label>
            <input id="nom" name="nom" type="text" autocomplete="name" required />
          </div>
          <div class="champ">
            <label for="societe">Company</label>
            <input id="societe" name="societe" type="text" autocomplete="organization" />
          </div>
          <div class="champ">
            <label for="email">Email <span class="champ__req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="champ">
            <label for="telephone">Phone</label>
            <input id="telephone" name="telephone" type="tel" autocomplete="tel" />
          </div>
          <div class="champ champ--large">
            <label for="message">Your project <span class="champ__req" aria-hidden="true">*</span></label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Target product, throughput required, raw materials…"></textarea>
          </div>
        </div>

        <!-- Mention de traitement des données : elle figurait sur le
             formulaire de l'ancien site et manquait ici. Reprise mot pour
             mot — à faire valider avec les mentions légales. -->
        <p class="formulaire__rgpd">
          By submitting this form, I agree that the personal data entered may
          be processed and used solely in connection with my contact request
          and any business relationship that may follow from it.
        </p>

        <div class="formulaire__pied">
          <p class="formulaire__note">* Required fields</p>
          <button class="btn btn--dark" type="submit">Send the request</button>
        </div>
      </form>
    </div>
  </section>
</PageLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-12);
    align-items: start;
  }

  /* ---- Colonne infos + carte ---- */

  .contact__infos {
    display: grid;
    gap: var(--space-8);
  }

  .contact__titre {
    font-size: var(--text-h2);
    font-weight: 650;
  }

  .contact__adresse {
    margin-top: var(--space-4);
    font-style: normal;
    line-height: var(--leading-normal);
    color: var(--text-body);
  }

  .contact__lignes {
    margin: var(--space-6) 0 0;
    display: grid;
    gap: var(--space-3);
  }

  .contact__lignes div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
  }

  .contact__lignes dt {
    font-size: var(--text-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }

  .contact__lignes dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .contact__map {
    margin: 0;
  }

  .contact__map iframe {
    display: block;
    width: 100%;
    height: 260px;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    /* Légère désaturation pour rester dans la palette acier */
    filter: grayscale(0.25) saturate(0.85);
    transition: filter var(--duration-slow) var(--ease-out);
  }

  .contact__map:hover iframe {
    filter: none;
  }

  .contact__map figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .contact__map figcaption a:hover {
    color: var(--highlight);
  }

  /* ---- Formulaire ---- */

  .formulaire {
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    box-shadow: var(--shadow-md);
  }

  .formulaire__intro {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 650;
    color: var(--text);
    margin-bottom: var(--space-6);
  }

  .formulaire__grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-6);
  }

  .champ {
    display: grid;
    gap: var(--space-2);
  }

  .champ--large {
    grid-column: 1 / -1;
  }

  .champ label {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--text);
  }

  .champ__req {
    color: var(--highlight);
  }

  .champ input,
  .champ textarea {
    font: inherit;
    color: var(--text);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--steel-50);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .champ textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .champ input::placeholder,
  .champ textarea::placeholder {
    color: var(--text-subtle);
  }

  .champ input:hover,
  .champ textarea:hover {
    border-color: var(--border-strong);
  }

  .champ input:focus-visible,
  .champ textarea:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 0;
    border-color: transparent;
    background: var(--surface-raised);
  }

  .formulaire__rgpd {
    margin-top: var(--space-6);
    font-size: var(--text-micro);
    line-height: var(--leading-normal);
    color: var(--text-muted);
    max-width: 62ch;
  }

  .formulaire__pied {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .formulaire__note {
    font-size: var(--text-micro);
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .contact {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .formulaire__grille {
      grid-template-columns: 1fr;
    }

    .formulaire {
      padding: var(--space-6);
    }

    .formulaire__pied {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
