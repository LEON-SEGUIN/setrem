---
import { Image } from 'astro:assets';
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import voeuxImg from '../../../assets/img/news-voeux-2026.webp';
---

<PageLayout
  title="2026, a new year taking shape - SETREM"
  description="We send you our very best wishes for the year 2026. May this fine year bring success, and be marked by shared opportunities and achievements."
  path="/en/news/2026-a-new-year-taking-shape"
>
  <PageHero
    kicker="News"
    titre="2026, a new year taking shape."
    lede="Season's greetings from the SETREM team."
    compact
  />

  <section class="band sheet" aria-label="The 2026 greetings">
    <div class="container">
      <article class="brve">
        <figure class="brve__cover reveal">
          <Image
            src={voeuxImg}
            alt="SETREM greetings card for 2026"
            widths={[700, 1100]}
            width={1100}
            quality={70}
            sizes="(max-width: 900px) 100vw, 900px"
            loading="eager"
          />
        </figure>
        <div class="brve__body prose">
          <p>
            We send you our very best wishes for the year 2026. May this fine
            year bring success, open new horizons and be marked by shared
            opportunities and achievements. Together, let us build a
            prosperous and inspiring future!
          </p>
        </div>
      </article>
    </div>
  </section>

  <CTABand />
</PageLayout>

<style>
  .brve {
    max-width: 56rem;
    margin-inline: auto;
  }

  .brve__cover {
    margin: 0 0 var(--space-8);
  }

  .brve__cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }
</style>
