---
import { Image } from 'astro:assets';
import logoW from '../assets/img/logo-w.svg';
import { ui, toLocale, contact } from '../i18n/ui';

const annee = new Date().getFullYear();
const t = ui[toLocale(Astro.currentLocale)].footer;
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Image src={logoW} alt="SETREM" width={160} height={45} loading="lazy" />
      <!-- Le pied de page reprend l'identité sous un autre angle que la
           déclaration de l'accueil : le métier (constructeur) et l'objet
           (l'extrudeur monovis), pas la date - elle est ailleurs. -->
      <p class="footer__tagline">{t.tagline}</p>
    </div>

    <nav class="footer__col" aria-label={t.planAria}>
      <p class="footer__head">{t.siteHead}</p>
      <ul>
        {t.site.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer__col">
      <p class="footer__head">{t.coordonneesHead}</p>
      <address class="footer__address">
        {contact.zone}, {contact.rue}<br />
        {contact.ville}, {t.pays}<br />
        <a href={contact.telHref}>{contact.tel}</a>
      </address>
      <a class="footer__linkedin" href={contact.linkedin} rel="noopener">
        LinkedIn
      </a>
    </div>

    <div class="footer__col">
      <p class="footer__head">{t.infosHead}</p>
      <ul>
        <!-- TODO: contenu client - mentions légales (SIRET, TVA, dirigeant)
             indisponibles : /mentions-legales de l'ancien site est en erreur. -->
        {t.infos.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {annee} {t.bas}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    background: var(--surface-dark);
    color: var(--steel-300);
    padding-block: var(--space-24) var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) repeat(3, minmax(0, 2.3fr));
    gap: var(--space-12);
  }

  .footer__tagline {
    margin-top: var(--space-4);
    max-width: 34ch;
    font-size: var(--text-small);
    color: var(--steel-400);
  }

  .footer__head {
    font-size: var(--text-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--steel-500);
    margin-bottom: var(--space-4);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-2);
  }

  .footer__col a {
    color: var(--steel-200);
    font-size: var(--text-small);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer__col a:hover {
    color: var(--teal-300);
  }

  .footer__address {
    font-style: normal;
    font-size: var(--text-small);
    color: var(--steel-300);
    line-height: var(--leading-normal);
  }

  .footer__linkedin {
    display: inline-block;
    margin-top: var(--space-4);
  }

  .footer__bottom {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    font-size: var(--text-micro);
    color: var(--steel-500);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
