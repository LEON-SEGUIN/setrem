---
// Données réelles du tableau des capacités : src/data/capacites.ts
// (partagées avec /nos-solutions/tableau-des-capacites-des-equipements).
import {
  modeles,
  getApplications,
  MAX,
  fmt,
  disclaimer,
} from '../data/capacites';
import { toLocale } from '../i18n/ui';

const locale = toLocale(Astro.currentLocale);
const applications = getApplications(locale);
const nb = (n: number) => fmt(n, locale);

const copy = {
  fr: {
    titre: 'Capacités : de 40 kg/h à 9 t/h.',
    sub: 'Du S50 au Z300, cinq applications sur une seule échelle. Les productions sont indicatives : formule, matières premières et granulométrie font varier les valeurs.',
    tabsAria: 'Capacités par application',
    chambres: 'chambres',
    voirTableau: 'Voir le tableau complet des capacités',
    caption:
      'Capacités des extrudeurs SETREM en kilogrammes par heure, par modèle et par application',
    thModele: 'Modèle',
    thChambres: 'Chambres',
    thPuissance: 'Puissance (kW)',
    lien: 'Consulter la page dédiée aux capacités →',
    lienHref: '/nos-solutions/tableau-des-capacites-des-equipements',
  },
  en: {
    titre: 'Capacities: from 40 kg/h to 9 t/h.',
    sub: 'From the S50 to the Z300, five applications on a single scale. Throughputs are indicative: formula, raw materials and particle size make the figures vary.',
    tabsAria: 'Capacities by application',
    chambres: 'chambers',
    voirTableau: 'View the full capacity table',
    caption:
      'SETREM extruder capacities in kilograms per hour, by model and by application',
    thModele: 'Model',
    thChambres: 'Chambers',
    thPuissance: 'Power (kW)',
    lien: 'See the dedicated capacities page →',
    lienHref: '/en/solutions/equipment-capacity-chart',
  },
}[locale];
---

<section class="capa" aria-labelledby="capa-titre">
  <div class="container">
    <div class="capa__head">
      <h2 class="capa__title reveal" id="capa-titre">{copy.titre}</h2>
      {/* « Six extrudeurs monovis couvrent l'ensemble des débits » est le
          chapô de la page dédiée : ici on décrit la lecture du graphique. */}
      <p class="capa__sub reveal">{copy.sub}</p>
    </div>

    {/* Seuls le titre et le chapô se révèlent. Le graphique est là dès
        l'arrivée et ce sont ses barres qui entrent : avec un fondu de plus
        sur les onglets, le cadre puis le tableau, la section restait une
        bande sombre vide le temps que tout arrive, puis les barres
        partaient encore une seconde après. */}
    <div class="capa__tabs" role="tablist" aria-label={copy.tabsAria} data-tabs>
      {
        applications.map((app, i) => (
          <button
            class="capa__tab"
            role="tab"
            id={`tab-${app.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${app.id}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {app.label}
          </button>
        ))
      }
    </div>

    <div class="capa__panel-wrap">
      {
        applications.map((app, i) => (
          <div
            class="capa__panel"
            role="tabpanel"
            id={`panel-${app.id}`}
            aria-labelledby={`tab-${app.id}`}
            hidden={i !== 0}
            data-bars
            data-loop
          >
            <div class="capa__panel-head">
              <p class="capa__panel-label">{app.label}</p>
              <p class="capa__panel-detail">{app.detail}</p>
            </div>

            <ul class="bars">
              {app.valeurs.map(([min, max], j) => (
                <li class="bars__row">
                  <div class="bars__meta">
                    <span class="model-ref bars__ref">{modeles[j].ref}</span>
                    <span class="bars__kw">
                      {modeles[j].kw} kW · {modeles[j].chambres}{' '}
                      {copy.chambres}
                    </span>
                  </div>
                  <div class="bars__track">
                    <div
                      class="bars__fill"
                      style={`--w: ${((max / MAX) * 100).toFixed(1)}%`}
                    >
                      <span class="bars__spark" aria-hidden="true" />
                      <span class="bars__spark" aria-hidden="true" />
                      <span class="bars__spark" aria-hidden="true" />
                    </div>
                  </div>
                  <p class="bars__value">
                    {nb(min)} - {nb(max)}
                    <span class="bars__unit">kg/h</span>
                  </p>
                </li>
              ))}
            </ul>

            <div class="bars__axis" aria-hidden="true">
              <span>0</span>
              <span>{nb(3000)}</span>
              <span>{nb(6000)}</span>
              <span>{nb(9000)} kg/h</span>
            </div>
          </div>
        ))
      }
    </div>

    <details class="capa__table">
      <summary>{copy.voirTableau}</summary>
      <div class="capa__table-scroll">
        <table>
          <caption class="visually-hidden">{copy.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{copy.thModele}</th>
              <th scope="col">{copy.thChambres}</th>
              <th scope="col">{copy.thPuissance}</th>
              {applications.map((app) => <th scope="col">{app.label}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              modeles.map((m, j) => (
                <tr>
                  <th scope="row" class="model-ref">{m.ref}</th>
                  <td>{m.chambres}</td>
                  <td>{m.kw}</td>
                  {applications.map((app) => (
                    <td>
                      {nb(app.valeurs[j][0])} - {nb(app.valeurs[j][1])}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="capa__disclaimer">{disclaimer[locale]}</p>
      <p class="capa__link">
        <a href={copy.lienHref}>{copy.lien}</a>
      </p>
    </details>
  </div>
</section>

<style>
  .capa {
    position: relative;
    z-index: 2;
    background: var(--surface-dark);
    padding-block: calc(var(--section) * 0.6);
    color: var(--steel-200);
  }

  .capa__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-8);
    align-items: start;
  }

  .capa__title {
    color: var(--steel-50);
    font-size: var(--text-h2);
    font-weight: 650;
    max-width: 26ch;
  }

  .capa__sub {
    font-size: var(--text-small);
    color: var(--steel-300);
    max-width: 52ch;
  }

  /* ---- Onglets ---- */

  .capa__tabs {
    margin-top: var(--space-6);
    display: flex;
    gap: var(--space-8);
    overflow-x: auto;
  }

  .capa__tab {
    position: relative;
    padding-block: var(--space-3);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--steel-500);
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .capa__tab:hover {
    color: var(--steel-200);
  }

  .capa__tab[aria-selected='true'] {
    color: var(--steel-50);
  }

  .capa__tab[aria-selected='true']::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(to right, var(--blue-300), var(--teal-400));
  }

  /* ---- Panneau de barres ---- */

  .capa__panel-wrap {
    margin-top: var(--space-6);
    border: 1px solid var(--steel-800);
    border-radius: var(--radius-lg);
    background:
      repeating-linear-gradient(
        to right,
        transparent 0,
        transparent calc(25% - 1px),
        var(--steel-900) calc(25% - 1px),
        var(--steel-900) 25%
      ),
      var(--steel-950);
  }

  .capa__panel {
    padding: var(--space-4) var(--space-6);
  }

  /* Changement d'onglet : le panneau entre en glissant, barres rejouées */
  .capa__panel.is-entering {
    animation: panel-in 0.45s var(--ease-out);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  .capa__panel-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .capa__panel-label,
  .capa__panel-detail {
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .capa__panel-label {
    color: var(--steel-200);
  }

  .capa__panel-detail {
    color: var(--steel-600);
  }

  .bars {
    display: grid;
    gap: var(--space-3);
  }

  .bars__row {
    display: grid;
    grid-template-columns: minmax(150px, 2fr) minmax(0, 9fr) minmax(130px, auto);
    align-items: center;
    gap: var(--space-4);
  }

  .bars__meta {
    display: grid;
  }

  .bars__ref {
    color: var(--steel-50);
    font-size: var(--text-small);
  }

  .bars__kw {
    font-size: var(--text-micro);
    color: var(--steel-600);
    font-variant-numeric: tabular-nums;
  }

  .bars__track {
    position: relative;
    height: 22px;
    border-radius: var(--radius-sm);
    background: rgba(237, 241, 243, 0.05);
    border: 1px solid var(--steel-800);
    overflow: hidden;
  }

  .bars__fill {
    position: relative;
    height: 100%;
    width: var(--w);
    border-radius: inherit;
    background: linear-gradient(to right, var(--blue-500), var(--blue-200));
    overflow: hidden;
  }

  /* Avec JS : la barre sort de la gauche à l'entrée dans le viewport,
     comme le produit sort de la filière. Elle glisse (transform) au lieu
     de s'élargir (width) : six barres qui changent de largeur, c'est une
     mise en page recalculée à chaque image ; un glissement se compose
     sans toucher au fil principal. Le rail (overflow: hidden) la coupe. */
  html.js [data-bars] .bars__fill {
    transform: translateX(-100%);
    transition: transform 1s var(--ease-out);
  }

  html.js [data-bars].is-visible .bars__fill {
    transform: none;
  }

  /* Reflet en mouvement continu dans la barre. Le dégradé est porté par
     un calque 2,2 fois plus large que la barre, qui glisse (transform) :
     animer background-position repeignait les six barres à chaque image,
     sur toute la page, même hors champ. La course reproduit l'ancienne
     (130 % → -30 % sur un fond de 220 %). Nom propre à ce composant :
     Hero.astro a déjà son `sheen`, et deux @keyframes du même nom dans
     la même feuille s'écrasent. */
  .bars__fill::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 220%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(247, 249, 250, 0.35) 50%,
      transparent 60%
    );
    transform: translateX(-70.9%);
  }

  @keyframes bars-sheen {
    from {
      transform: translateX(-70.9%);
    }
    to {
      transform: translateX(16.4%);
    }
  }

  .bars__spark {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--steel-50);
    opacity: 0;
  }

  /* Reflet et étincelles ne tournent que panneau à l'écran ([data-loop],
     scroll.js) : au repos, le reflet attend hors de la barre et les
     étincelles sont éteintes. */
  @media (prefers-reduced-motion: no-preference) {
    html.js [data-bars].is-playing .bars__fill::after {
      animation: bars-sheen 3.2s var(--ease-linear) infinite;
    }

    html.js [data-bars].is-playing .bars__spark {
      animation: bars-spark 2.8s ease-in-out infinite;
      /* Décalage porté par une variable : le raccourci `animation`
         ci-dessus écraserait un animation-delay posé plus bas. */
      animation-delay: var(--spark-delay, 0s);
    }
  }

  .bars__spark:nth-child(1) {
    left: 32%;
    top: 30%;
  }

  .bars__spark:nth-child(2) {
    left: 58%;
    top: 60%;
    --spark-delay: 0.9s;
  }

  .bars__spark:nth-child(3) {
    left: 81%;
    top: 42%;
    --spark-delay: 1.7s;
  }

  @keyframes bars-spark {
    0%, 100% {
      opacity: 0;
      scale: 0.6;
    }
    50% {
      opacity: 0.9;
      scale: 1;
    }
  }

  .bars__value {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: var(--text-small);
    color: var(--steel-50);
    text-align: right;
    white-space: nowrap;
  }

  .bars__unit {
    color: var(--steel-500);
    font-weight: 400;
  }

  .bars__axis {
    margin-top: var(--space-4);
    display: flex;
    justify-content: space-between;
    font-size: var(--text-micro);
    color: var(--steel-600);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Tableau complet ---- */

  .capa__table {
    margin-top: var(--space-6);
  }

  .capa__table summary {
    cursor: pointer;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--steel-300);
    padding: var(--space-3) 0;
  }

  .capa__table summary:hover {
    color: var(--steel-50);
  }

  .capa__table-scroll {
    overflow-x: auto;
    margin-top: var(--space-4);
  }

  .capa__table table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-small);
    white-space: nowrap;
  }

  .capa__table th,
  .capa__table td {
    text-align: left;
    padding: var(--space-3) var(--space-4);
    color: var(--steel-200);
  }

  /* Sans filets : un zébrage discret guide l'œil d'une ligne à l'autre */
  .capa__table tbody tr:nth-child(odd) {
    background: color-mix(in srgb, var(--steel-50) 4%, transparent);
  }

  .capa__table thead th {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--steel-500);
  }

  .capa__table tbody th {
    color: var(--steel-50);
  }

  .capa__disclaimer {
    margin-top: var(--space-4);
    font-size: var(--text-micro);
    color: var(--steel-600);
    max-width: 62ch;
  }

  .capa__link {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    font-weight: 600;
  }

  .capa__link a {
    color: var(--teal-300);
  }

  .capa__link a:hover {
    color: var(--teal-200);
  }

  @media (max-width: 900px) {
    .capa__head {
      grid-template-columns: 1fr;
    }

    .bars__row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .bars__value {
      text-align: left;
    }
  }
</style>
