---
// Carte d'article « L'œil de l'expert ».
// Une seule écriture pour le carrousel de l'accueil et la grille de
// /loil-de-lexpert : même anatomie, même survol, deux mises en page.
// Pas de cadre ni de fond : la photo, le numéro, le titre, l'extrait -
// posés directement sur la page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  titre: string;
  extrait: string;
  image: ImageMetadata;
  alt: string;
  numero: number;
  sizes?: string;
  widths?: number[];
  lignes?: number; // lignes d'extrait avant troncature
}

const {
  href,
  titre,
  extrait,
  image,
  alt,
  numero,
  sizes = '(min-width: 40rem) 30rem, 78vw',
  widths = [480, 960],
  lignes = 2,
} = Astro.props;
---

<article class="acard" style={`--acard-lines: ${lignes}`}>
  <a class="acard__link" href={href}>
    <span class="acard__media">
      <Image
        src={image}
        alt={alt}
        widths={widths}
        width={widths.at(-1)}
        quality={70}
        sizes={sizes}
        loading="lazy"
      />
    </span>
    <span class="acard__num" aria-hidden="true">
      {String(numero).padStart(2, '0')}
    </span>
    <h3 class="acard__title">{titre}</h3>
    <p class="acard__excerpt">{extrait}</p>
  </a>
</article>

<style>
  .acard__link {
    display: grid;
    color: inherit;
  }

  /* ---- La photo ---- */

  .acard__media {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-sunken);
  }

  .acard__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    /* Dérive lente : l'aller-retour demande une courbe symétrique */
    transition: scale var(--duration-slower) var(--ease-in-out);
  }

  .acard__link:hover .acard__media :global(img) {
    scale: 1.045;
  }

  /* ---- Le texte ---- */

  .acard__num {
    display: block;
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    font-variant-numeric: tabular-nums;
    color: var(--highlight);
  }

  .acard__title {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    font-weight: 650;
    line-height: 1.3;
    text-wrap: pretty;
    transition: color var(--duration-base) var(--ease-out);
  }

  .acard__link:hover .acard__title {
    color: var(--accent);
  }

  .acard__excerpt {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--acard-lines, 2);
    line-clamp: var(--acard-lines, 2);
    overflow: hidden;
  }

  /* Le focus clavier porte sur toute la carte, pas sur le seul texte */
  .acard__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }
</style>
