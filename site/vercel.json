{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/news", "destination": "/actualites", "statusCode": 301 },
    {
      "source": "/news/nouveau-site-internet",
      "destination": "/actualites",
      "statusCode": 301
    },
    {
      "source": "/news/2026-a-new-year-taking-shape",
      "destination": "/actualites/2026-une-nouvelle-annee",
      "statusCode": 301
    },
    {
      "source": "/news/eurotier-10-au-13-november-2026-a-hanovre",
      "destination": "/actualites/eurotier-2026-hanovre",
      "statusCode": 301
    },
    { "source": "/les-ressources", "destination": "/ressources", "statusCode": 301 },
    {
      "source": "/les-ressources/pdfs",
      "destination": "/ressources",
      "statusCode": 301
    },
    {
      "source": "/loil-de-lexpert/traitement-des-matieres-premieres-soja",
      "destination": "/loil-de-lexpert/procede-de-traitement-de-la-graine-de-soja",
      "statusCode": 301
    },
    {
      "source": "/loil-de-lexpert/nos-preconditionneurs-pbr",
      "destination": "/nos-solutions/preconditionneurs",
      "statusCode": 301
    },
    {
      "source": "/en/expert-insights/raw-material-processing-soybean",
      "destination": "/en/expert-insights/soybean-processing-method",
      "statusCode": 301
    },
    {
      "source": "/en/expert-insights/our-pbr-preconditioners",
      "destination": "/en/solutions/preconditioners",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
